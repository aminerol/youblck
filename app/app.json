{
  "expo": {
    "name": "YouBlock",
    "slug": "you-block",
    "privacy": "hidden",
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMobileAdsAutoInit": true
      }
    },
    "android": {
      "config": {
        "googleMobileAdsAutoInit": true
      }
    },
    "description": "YouBlock - an app for blocking videos and channels from showing up on youtube app",
    "assetBundlePatterns": ["**/*"],
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    }
  },
  "displayName": "You Block",
  "name": "YouBlock"
}
