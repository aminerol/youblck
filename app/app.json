{
  "expo": {
    "name": "YouBlock",
    "slug": "you-block",
    "privacy": "hidden",
    "platforms": ["ios", "android"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMobileAdsAutoInit": true
      }
    },
    "android": {
      "config": {
        "googleMobileAdsAutoInit": true
      },
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "description": "YouBlock - an app for blocking videos and channels from showing up on youtube app",
    "assetBundlePatterns": ["**/*"],
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": ["sentry-expo"]
  },
  "displayName": "You Block",
  "name": "YouBlock"
}
