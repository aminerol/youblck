    "url": "^0.11.0"
  },
  "devDependencies": {
    "@babel/core": "~7.9.0",
    "@expo/config": "^5.0.6",
    "@types/lodash": "^4.14.170",
    "@types/react": "~16.9.35",
    "@types/react-native": "~0.63.2",
    "custom-env": "^2.0.1",
    "dotenv": "^10.0.0",
    "patch-package": "^6.4.7",
    "typescript": "~4.0.0"
  },
  "scripts": {
    "start:staging": "ENV=staging expo start",
    "start:production": "ENV=production expo start",
    "publish:staging": "ENV=staging expo publish --release-channel staging",
    "publish:production": "ENV=production expo publish --release-channel production",
    "build:simulator:ios": "ENV=staging eas build -p ios --profile simulator --local",
    "build:staging:ios": "ENV=staging eas build -p ios --profile staging --local",
    "build:production:ios": "ENV=production eas build -p ios --profile release --local",
    "build:simulator:android": "ENV=staging eas build -p android --profile simulator --local",
    "build:staging:android": "ENV=staging eas build -p android --profile staging --local",
    "build:production:android": "ENV=production eas build -p android --profile release --local",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "postinstall": "yarn patch-package",
    "eas-build-pre-install": "cd ../core && yarn install && yarn build && cd ../app"
  },
  "private": true
}
