{
  "build": {
    "release": {
      "releaseChannel": "production",
      "distribution": "store",
      "env": {
        "ENV": "production"
      }
    },
    "staging": {
      "releaseChannel": "staging",
      "distribution": "internal",
      "env": {
        "ENV": "staging"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "simulator": {
      "releaseChannel": "staging",
      "distribution": "internal",
      "env": {
        "ENV": "staging"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    }
  },
  "cli": {
    "version": ">= 0.38.3"
  }
}
